# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server
PORT=3000

# Rate limiting (per IP, sliding window)
RATE_LIMIT_WINDOW_HOURS=24
RATE_LIMIT_MAX_MESSAGES=30

# Per-message limits
MAX_INPUT_CHARS=2000
MAX_OUTPUT_TOKENS=600

# Contact composer (chat panel → Justin's inbox).
# Without RESEND_API_KEY messages are still saved to server/messages.jsonl,
# but nothing notifies you - set the key to get the email.
RESEND_API_KEY=
CONTACT_TO=jjhatch03@gmail.com
# Must be a domain verified in Resend. onboarding@resend.dev works for testing
# but only delivers to the address that owns the Resend account.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
RATE_LIMIT_MAX_CONTACT=5
